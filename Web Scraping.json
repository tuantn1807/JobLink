    {
      "parameters": {
        "jsCode": "const allItems = $input.all();\nconst results = [];\nconst tracker = {}; \n\nfor (const item of allItems) {\n  const markdown = item.json.data?.markdown || item.json.content || \"\";\n  \n  // KIỂM TRA NẾU BỊ CHẶN:\n  if (markdown.includes(\"Phiên làm việc của bạn đã hết hạn\") || markdown.includes(\"reCAPTCHA\")) {\n      // Bạn có thể đẩy ra một thông báo lỗi để biết trang nào bị chặn\n      continue; \n  }\n\n  // 1. Lọc TopCV (Giữ nguyên vì đã chạy tốt)\n  const topcvRegex = /###\\s\\[[^\\]]+\\]\\((https:\\/\\/(www\\.)?topcv\\.vn\\/(viec-lam|brand\\/[^\\/]+\\/tuyen-dung)\\/[^\\s\\?)]+)/g;\n  let match;\n  while ((match = topcvRegex.exec(markdown)) !== null) {\n    let url = match[1].split('?')[0]; \n    if (!tracker[url]) {\n      tracker[url] = true;\n      results.push({ json: { job_url: url, site: \"TopCV\" } });\n    }\n  }\n\n  // 2. Lọc CareerLink (Sửa Regex để linh hoạt hơn)\n  // Giải thích: Bắt mọi thứ sau /viec-lam/ hoặc /job/ cho đến khi gặp dãy số ID ở cuối\n  const careerlinkRegex = /(https:\\/\\/www\\.careerlink\\.vn\\/(?:viec-lam|job)\\/[^\\s\\?)\\\"]+\\/\\d+)/g;\n  \n  let cMatch;\n  while ((cMatch = careerlinkRegex.exec(markdown)) !== null) {\n    let url = cMatch[0].split('?')[0];\n    // Loại bỏ dấu đóng ngoặc đơn nếu Regex vô tình bắt dính ở cuối link markdown\n    url = url.replace(/\\)$/, \"\"); \n\n    if (!tracker[url]) {\n      tracker[url] = true;\n      results.push({ json: { job_url: url, site: \"CareerLink\" } });\n    }\n  }\n}\n\nreturn results;"
      },
