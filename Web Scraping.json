    {
      "parameters": {
        "jsCode": "// Lấy ID cuối cùng từ node Google Sheets (đặt tên node đó là 'GetLastID')\nlet lastId = 0;\ntry {\n  lastId = parseInt($node[\"GetLastID\"].json[\"job_id\"]) || 0;\n} catch (e) {\n  lastId = 0;\n}\n\n// Lấy danh sách jobs mà AI vừa trả về (đã parse từ chuỗi JSON)\nconst aiOutput = JSON.parse($json.output.replace(/```json|```/g, \"\"));\n\nreturn aiOutput.map(job => {\n  lastId++; // Tự tăng ID\n  return {\n    json: {\n      job_id: lastId,\n      ...job\n    }\n  }\n});"
      },
